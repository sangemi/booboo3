generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PostCategory {
  TALK
  VERDICT
  WORRY
  TIPS
  PARENTING
  TOGETHER
  LETTERS
}

enum ReactionType {
  ME_TOO
  HUG
  SAVED
  HELPFUL
}

enum CommentTone {
  SUPPORT
  ADVICE
  QUESTION
}

enum LetterTone {
  THANKS
  SORRY
  HURT
}

enum LetterReactionType {
  UP
  DOWN
}

enum VerdictChoice {
  HUSBAND
  WIFE
  BOTH
  NOT_ENOUGH
}

enum FeedbackStatus {
  OPEN
  REVIEWING
  RESOLVED
  HIDDEN
}

enum PersonaType {
  GENDER
  AGE_GROUP
  EMPLOYER
  PROFESSION
  MARRIAGE_YEARS
  PARENTING
  OTHER
}

enum PersonaVerificationStatus {
  DECLARED
  PENDING
  VERIFIED
  REJECTED
}

enum PersonaVerificationSource {
  SELF
  GOOGLE
  KAKAO
  WORK_EMAIL
  DOCUMENT
  ADMIN
}

enum PersonaReviewStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum WalletAsset {
  CASH
  POINT
}

enum WalletTransactionType {
  ADMIN_GRANT
  PURCHASE
  SPEND
  REFUND
  REWARD
  ADJUSTMENT
}

model User {
  id                 String              @id @default(cuid())
  name               String?
  email              String?             @unique
  emailVerified      DateTime?
  image              String?
  passwordHash       String?
  nickname           String?             @unique
  coupleStage        String?
  role               String              @default("MEMBER")
  /// Paid virtual balance. Purchase flows can be connected later.
  cashBalance        Int                 @default(0)
  /// Free balance earned from community activity or events.
  pointBalance       Int                 @default(0)
  accounts           Account[]
  sessions           Session[]
  personas           UserPersona[]
  posts              Post[]
  comments           Comment[]
  reactions          Reaction[]
  verdictVotes       VerdictVote[]
  temperatureChecks  TemperatureCheck[]
  missionCompletions MissionCompletion[]
  missionReflections MissionReflection[]
  letters            AnonymousLetter[]
  badges             UserBadge[]
  feedback           Feedback[]
  walletTransactions WalletTransaction[] @relation("WalletOwner")
  walletActions      WalletTransaction[] @relation("WalletActor")
  adminActions       AdminActionLog[]     @relation("AdminActionActor")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model UserPersona {
  id              String                    @id @default(cuid())
  userId          String
  type            PersonaType
  label           String
  value           String
  normalizedValue String
  isPublic        Boolean                   @default(true)
  status          PersonaVerificationStatus @default(DECLARED)
  source          PersonaVerificationSource @default(SELF)
  sourceRef       String?
  verifiedAt      DateTime?
  user            User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verifications   PersonaVerification[]
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@unique([userId, type, normalizedValue])
  @@index([userId, status])
}

model PersonaVerification {
  id         String                    @id @default(cuid())
  personaId  String
  source     PersonaVerificationSource
  status     PersonaReviewStatus       @default(PENDING)
  sourceRef  String?
  evidence   Json?
  reviewedAt DateTime?
  persona    UserPersona               @relation(fields: [personaId], references: [id], onDelete: Cascade)
  createdAt  DateTime                  @default(now())
  updatedAt  DateTime                  @updatedAt

  @@index([personaId, createdAt])
  @@index([status, createdAt])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Post {
  id                 String        @id @default(cuid())
  /// Stable public identifier used in /talk/post/:publicId URLs.
  publicId           Int           @unique @default(autoincrement())
  category           PostCategory
  title              String
  body               String
  authorId           String?
  authorName         String        @default("익명의 부부")
  coupleStage        String?
  mood               String?
  temperature        Int?
  readMinutes        Int           @default(1)
  isPinned           Boolean       @default(false)
  isAnonymous        Boolean       @default(false)
  tags               String[]      @default([])
  /// Legacy compatibility for booboo2 URLs and migrated posts.
  /// TODO(legacy): Remove after 2027-06 if old /talk/post/:id traffic is no longer needed.
  legacyId           Int?          @unique
  /// Legacy compatibility for booboo2 URLs and migrated posts.
  /// TODO(legacy): Remove after 2027-06 if old /talk/post/:id traffic is no longer needed.
  legacyPath         String?       @unique
  /// Legacy compatibility for source auditing during the booboo2 -> booboo3 migration.
  /// TODO(legacy): Remove after 2027-06 after migration audits are complete.
  legacySource       String?
  /// Legacy compatibility for migrated booboo2 public counters.
  /// TODO(legacy): Remove after 2027-06 after migration audits are complete.
  legacyViewCount    Int?
  /// Legacy compatibility for migrated booboo2 public counters.
  /// TODO(legacy): Remove after 2027-06 after migration audits are complete.
  legacyLikeCount    Int?
  /// Legacy compatibility for migrated booboo2 public counters.
  /// TODO(legacy): Remove after 2027-06 after migration audits are complete.
  legacyDislikeCount Int?
  /// Legacy compatibility for preserving the original booboo2 publication time.
  /// TODO(legacy): Remove after 2027-06 after migration audits are complete.
  legacyCreatedAt    DateTime?
  author             User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  comments           Comment[]
  reactions          Reaction[]
  verdictVotes       VerdictVote[]
  feedback           Feedback[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([category, createdAt])
  @@index([legacyId])
}

model Comment {
  id              String      @id @default(cuid())
  postId          String
  authorId        String?
  authorName      String      @default("방문자")
  isAnonymous     Boolean     @default(true)
  body            String
  tone            CommentTone @default(SUPPORT)
  /// Legacy compatibility for migrated booboo2 comments.
  /// TODO(legacy): Remove after 2027-06 if old comment audit data is no longer needed.
  legacyId        Int?        @unique
  /// Legacy compatibility for source auditing during the booboo2 -> booboo3 migration.
  /// TODO(legacy): Remove after 2027-06 after migration audits are complete.
  legacySource    String?
  /// Legacy compatibility for preserving the original booboo2 comment time.
  /// TODO(legacy): Remove after 2027-06 after migration audits are complete.
  legacyCreatedAt DateTime?
  post            Post        @relation(fields: [postId], references: [id], onDelete: Cascade)
  author          User?       @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([postId, createdAt])
  @@index([legacyId])
}

model Reaction {
  id        String       @id @default(cuid())
  type      ReactionType
  postId    String
  userId    String?
  anonKey   String?
  post      Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@unique([postId, type, userId])
  @@index([postId, type])
  @@index([userId, type, createdAt])
}

model VerdictVote {
  id        String        @id @default(cuid())
  choice    VerdictChoice
  postId    String
  userId    String?
  /// Legacy anonymous votes. New votes require an authenticated userId.
  anonKey   String?
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([postId, userId])
  @@index([postId, choice])
  @@index([userId])
  @@index([createdAt])
}

model TemperatureCheck {
  id        String   @id @default(cuid())
  userId    String?
  anonKey   String?
  score     Int
  note      String?
  checkedAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([checkedAt])
}

model Mission {
  id          String              @id @default(cuid())
  title       String
  prompt      String
  difficulty  String
  isActive    Boolean             @default(true)
  completions MissionCompletion[]
  reflections MissionReflection[]
  createdAt   DateTime            @default(now())
}

model MissionCompletion {
  id          String   @id @default(cuid())
  missionId   String
  userId      String?
  anonKey     String?
  reflection  String?
  completedOn DateTime @default(dbgenerated("CURRENT_DATE")) @db.Date
  mission     Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  completedAt DateTime @default(now())

  @@unique([missionId, userId, completedOn])
  @@index([missionId, completedAt])
}

model MissionReflection {
  id          String   @id @default(cuid())
  missionId   String
  userId      String
  body        String
  missionDate DateTime @db.Date
  mission     Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([missionId, missionDate, createdAt])
  @@index([userId, createdAt])
}

model AnonymousLetter {
  id        String           @id @default(cuid())
  title     String
  body      String
  tone      LetterTone
  authorId  String?
  author    User?            @relation(fields: [authorId], references: [id], onDelete: SetNull)
  replies   LetterReply[]
  reactions LetterReaction[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model LetterReaction {
  id        String             @id @default(cuid())
  letterId  String
  anonKey   String
  type      LetterReactionType
  letter    AnonymousLetter    @relation(fields: [letterId], references: [id], onDelete: Cascade)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([letterId, anonKey])
  @@index([letterId, type])
}

model LetterReply {
  id         String          @id @default(cuid())
  letterId   String
  body       String
  authorName String          @default("익명의 응원")
  letter     AnonymousLetter @relation(fields: [letterId], references: [id], onDelete: Cascade)
  createdAt  DateTime        @default(now())
}

model Badge {
  id          String      @id @default(cuid())
  slug        String      @unique
  title       String
  description String
  users       UserBadge[]
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  badgeId  String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge    Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  earnedAt DateTime @default(now())

  @@unique([userId, badgeId])
}

model Feedback {
  id        String         @id @default(cuid())
  postId    String?
  userId    String?
  kind      String
  body      String
  status    FeedbackStatus @default(OPEN)
  post      Post?          @relation(fields: [postId], references: [id], onDelete: SetNull)
  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model AiOperationEntry {
  id          String         @id @default(cuid())
  title       String
  source      String
  summary     String
  decision    String
  publicNotes String[]       @default([])
  status      FeedbackStatus @default(OPEN)
  happenedAt  DateTime       @default(now())
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([happenedAt])
  @@index([source, status])
}

model WalletTransaction {
  id           String                @id @default(cuid())
  userId       String
  actorId      String?
  asset        WalletAsset
  type         WalletTransactionType
  amount       Int
  balanceAfter Int
  reason       String
  user         User                  @relation("WalletOwner", fields: [userId], references: [id], onDelete: Cascade)
  actor        User?                 @relation("WalletActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt    DateTime              @default(now())

  @@index([userId, asset, createdAt])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

model AdminActionLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  actor      User?    @relation("AdminActionActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
}
